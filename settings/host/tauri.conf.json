{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GuiyuX Settings",
  "version": "0.1.0",
  "identifier": "app.guiyux.settings",
  "build": { "frontendDist": "../dist" },
  "app": {
    "windows": [{
      "label": "settings",
      "title": "GuiyuX",
      "center": true,
      "width": 840,
      "height": 592,
      "minWidth": 640,
      "minHeight": 440,
      "theme": "Dark",
      "backgroundColor": "#202022",
      "dragDropEnabled": false,
      "visible": false
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'",
      "capabilities": [{
        "identifier": "local-settings",
        "windows": ["settings"],
        "permissions": ["core:event:allow-listen", "core:event:allow-unlisten", "core:window:allow-close", "core:window:allow-destroy", "dialog:allow-open"]
      }]
    }
  },
  "bundle": { "active": false, "icon": ["../../assets/guiyuX.ico"] }
}
